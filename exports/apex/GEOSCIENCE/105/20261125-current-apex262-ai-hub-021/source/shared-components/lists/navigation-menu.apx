list navigation-menu (
    name: Navigation Menu

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-user-wrench
        }
        layout {
            sequence: 10000
        }
        link {
            target: {
                page: 10000
            }
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry ask-ai (
        label: Ask AI
        icon {
            imageIconCssClasses: fa-comments-o
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry explore-data (
        label: Explore Data
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry refresh-data (
        label: Refresh Data
        icon {
            imageIconCssClasses: fa-refresh
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry reports (
        label: Reports
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 6
            }
        }
    )

)

