page 2 (
    name: Account Requests
    alias: ACCOUNT-REQUESTS
    title: Account Requests
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>To find data enter a search term into the search dialog, or click on the column headings to limit the records returned.</p>
            
            <p>You can perform numerous functions by clicking the <strong>Actions</strong> button. This includes selecting the columns that are displayed / hidden and their display sequence, plus numerous data and format functions.  You can also define additional views of the data using the chart, group by, and pivot options.</p>
            
            <p>If you want to save your customizations select report, or click download to unload the data. Enter you email address and time frame under subscription to be sent the data on a regular basis.<p>
            
            <p>For additional information click Help at the bottom of the Actions menu.</p> 
            
            <p>Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }

    region account-requests (
        name: Account Requests
        type: interactiveReport
        source {
            location: localDatabase
            tableName: GS_ACCOUNT_REQUESTS
        }
        layout {
            sequence: 10
            slot: body
        }
        link {
            linkColumn: customTarget
            target: {
                page: 3
                items: {
                    P3_REQUEST_ID: \#REQUEST_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 16166609529959939
        }

        column AI_SUMMARY (
            type: plainText
            heading {
                heading: Ai Summary
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column BUSINESS_REASON (
            type: plainText
            heading {
                heading: Business Reason
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column COMPLETED_AT (
            type: plainText
            heading {
                heading: Completed At
            }
            layout {
                sequence: 11
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: K
            }
        )

        column CREATED_AT (
            type: plainText
            heading {
                heading: Created At
            }
            layout {
                sequence: 12
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: L
            }
        )

        column PERSON_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Person
            }
            lov {
                lov: @gs-people-display-name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: C
            }
        )

        column REQUESTED_AT (
            type: plainText
            heading {
                heading: Requested At
            }
            layout {
                sequence: 6
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: F
            }
        )

        column REQUESTED_BY (
            type: plainText
            heading {
                heading: Requested By
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column REQUEST_ID (
            type: hidden
            heading {
                heading: Request ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column REQUEST_NUMBER (
            type: plainText
            heading {
                heading: Request Number
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column REQUEST_TYPE_CODE (
            type: plainText
            heading {
                heading: Request Type Code
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column STATUS_CODE (
            type: plainText
            heading {
                heading: Status Code
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column TARGET_DUE_DATE (
            type: plainText
            heading {
                heading: Target Due Date
            }
            layout {
                sequence: 10
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: J
            }
        )

        column UPDATED_AT (
            type: plainText
            heading {
                heading: Updated At
            }
            layout {
                sequence: 13
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: M
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Account Requests
        }

        savedReport 161753 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AI_SUMMARY (
                sequence: 8
            )

            displayColumn BUSINESS_REASON (
                sequence: 7
            )

            displayColumn COMPLETED_AT (
                sequence: 10
            )

            displayColumn CREATED_AT (
                sequence: 11
            )

            displayColumn PERSON_ID (
                sequence: 2
            )

            displayColumn REQUESTED_AT (
                sequence: 5
            )

            displayColumn REQUESTED_BY (
                sequence: 4
            )

            displayColumn REQUEST_NUMBER (
                sequence: 1
            )

            displayColumn REQUEST_TYPE_CODE (
                sequence: 3
            )

            displayColumn STATUS_CODE (
                sequence: 6
            )

            displayColumn TARGET_DUE_DATE (
                sequence: 9
            )

            displayColumn UPDATED_AT (
                sequence: 12
            )

            sort (
                column: REQUEST_NUMBER
                sort {
                    sequence: 1
                }
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @account-requests
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
                clearCache: 3
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @account-requests
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @account-requests
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

