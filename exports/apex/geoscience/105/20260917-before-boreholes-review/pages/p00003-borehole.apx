page 3 (
    name: Borehole
    alias: BOREHOLE
    title: Borehole
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region borehole (
        name: Borehole
        type: form
        source {
            location: localDatabase
            tableName: GS_BOREHOLES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P3_BOREHOLE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @borehole
            slot: regionBody
        }
        source {
            formRegion: @borehole
            column: BOREHOLE_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P3_BOREHOLE_NAME (
        type: textField
        label {
            label: Borehole Name
            alignment: right
        }
        layout {
            sequence: 40
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 240
        }
        source {
            formRegion: @borehole
            column: BOREHOLE_NAME
            dataType: varchar2
        }
    )

    pageItem P3_BOREHOLE_REF (
        type: textField
        label {
            label: Borehole Ref
            alignment: right
        }
        layout {
            sequence: 30
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @borehole
            column: BOREHOLE_REF
            dataType: varchar2
        }
    )

    pageItem P3_COMMODITY_GROUP (
        type: textField
        label {
            label: Commodity Group
            alignment: right
        }
        layout {
            sequence: 110
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 160
        }
        source {
            formRegion: @borehole
            column: COMMODITY_GROUP
            dataType: varchar2
        }
    )

    pageItem P3_CREATED_AT (
        type: datePicker
        label {
            label: Created At
            alignment: right
        }
        layout {
            sequence: 140
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @borehole
            column: CREATED_AT
            dataType: timestampWithLocalTimeZone
        }
    )

    pageItem P3_DEPTH_METRES (
        type: numberField
        label {
            label: Depth Metres
            alignment: right
        }
        layout {
            sequence: 90
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @borehole
            column: DEPTH_METRES
            dataType: number
        }
    )

    pageItem P3_DRILLED_YEAR (
        type: numberField
        label {
            label: Drilled Year
            alignment: right
        }
        layout {
            sequence: 100
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @borehole
            column: DRILLED_YEAR
            dataType: number
        }
    )

    pageItem P3_LATITUDE (
        type: numberField
        label {
            label: Latitude
            alignment: right
        }
        layout {
            sequence: 70
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @borehole
            column: LATITUDE
            dataType: number
        }
    )

    pageItem P3_LONGITUDE (
        type: numberField
        label {
            label: Longitude
            alignment: right
        }
        layout {
            sequence: 80
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @borehole
            column: LONGITUDE
            dataType: number
        }
    )

    pageItem P3_REGION_NAME (
        type: textField
        label {
            label: Region Name
            alignment: right
        }
        layout {
            sequence: 60
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 160
        }
        source {
            formRegion: @borehole
            column: REGION_NAME
            dataType: varchar2
        }
    )

    pageItem P3_SOURCE_ID (
        type: selectList
        label {
            label: Source
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @gs-borehole-sources-source-name
        }
        layout {
            sequence: 20
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @borehole
            column: SOURCE_ID
            dataType: number
        }
    )

    pageItem P3_SOURCE_UPDATED_AT (
        type: datePicker
        label {
            label: Source Updated At
            alignment: right
        }
        layout {
            sequence: 130
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @borehole
            column: SOURCE_UPDATED_AT
            dataType: timestampWithLocalTimeZone
        }
    )

    pageItem P3_STATE_CODE (
        type: textField
        label {
            label: State Code
            alignment: right
        }
        layout {
            sequence: 50
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @borehole
            column: STATE_CODE
            dataType: varchar2
        }
    )

    pageItem P3_STATUS_CODE (
        type: textField
        label {
            label: Status Code
            alignment: right
        }
        layout {
            sequence: 120
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 40
        }
        source {
            formRegion: @borehole
            column: STATUS_CODE
            dataType: varchar2
        }
    )

    pageItem P3_UPDATED_AT (
        type: datePicker
        label {
            label: Updated At
            alignment: right
        }
        layout {
            sequence: 150
            region: @borehole
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @borehole
            column: UPDATED_AT
            dataType: timestampWithLocalTimeZone
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_BOREHOLE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_BOREHOLE_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_BOREHOLE_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation p3-created-at-must-be-timestamp (
        name: P3_CREATED_AT must be timestamp
        execution {
            sequence: 130
        }
        validation {
            type: itemIsAValidTimestamp
            item: P3_CREATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P3_CREATED_AT
        }
    )

    validation p3-source-updated-at-must-be-timestamp (
        name: P3_SOURCE_UPDATED_AT must be timestamp
        execution {
            sequence: 120
        }
        validation {
            type: itemIsAValidTimestamp
            item: P3_SOURCE_UPDATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P3_SOURCE_UPDATED_AT
        }
    )

    validation p3-updated-at-must-be-timestamp (
        name: P3_UPDATED_AT must be timestamp
        execution {
            sequence: 140
        }
        validation {
            type: itemIsAValidTimestamp
            item: P3_UPDATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P3_UPDATED_AT
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 16378464900978428
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-borehole (
        name: Initialize form Borehole
        type: formInitialization
        formRegion: @borehole
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16377637388978427
        }
    )

    process process-form-borehole (
        name: Process form Borehole
        type: formAutoRowProcessing
        formRegion: @borehole
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16378029582978428
        }
    )

)

